{
  "permissions": {
    "allow": [
      "mcp__Gmail__send_message"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/council/hooks/council-sync.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/council/tools/context_size.py\" --hook"
          }
        ]
      }
    ]
  }
}
